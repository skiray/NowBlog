---
import { useTranslations } from "../i18n/ui";
const t = useTranslations(Astro.currentLocale ?? "zh");
const socials = [{ label: t("about.email"), href: "mailto:666@qq.com" }];
---

<section class="section" id="about">
  <div class="container narrow">
    <div class="head reveal">
      <span class="eyebrow">{t("about.eyebrow")}</span>
      <h2>{t("about.title")}</h2>
    </div>
    <div class="bio reveal" set:html={t("about.bio")} />
    <div class="socials reveal">
      {
        socials.map((s) => (
          <a class="social" href={s.href} target="_blank" rel="me">
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .container.narrow {
    max-width: 720px;
    text-align: center;
  }
  .head {
    margin-bottom: 24px;
  }
  h2 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    margin-top: 12px;
  }
  .bio {
    color: var(--text-dim);
    font-size: 1.08rem;
    margin: 0 auto 32px;
    max-width: 640px;
    text-align: left;
  }
  .bio :global(p) {
    margin-bottom: 16px;
  }
  .bio :global(h3) {
    font-size: 1.2rem;
    color: var(--text);
    margin: 32px 0 12px;
  }
  .bio :global(ul) {
    list-style: disc;
    padding-left: 22px;
    margin-bottom: 16px;
    display: grid;
    gap: 8px;
  }
  .bio :global(.sign) {
    margin-top: 28px;
    color: var(--text);
    font-weight: 600;
    line-height: 1.8;
  }
  .socials {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .social {
    color: var(--text);
    font-weight: 600;
    font-size: 1.05rem;
    padding: 14px 30px;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .social:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--ghost-bg);
  }
  .social:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
