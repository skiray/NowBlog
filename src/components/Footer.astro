---
import { defaultLocale, useTranslations, type Locale } from "../i18n/ui";
import { prefix } from "../i18n/routing";
import { SITE_EMAIL } from "../consts";

const year = new Date().getFullYear();
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
// Footer links must stay inside the active locale (RSS is per-locale too).
const base = prefix(locale);
---

<footer class="footer">
  <div class="container footer-inner">
    <a class="brand" href={`${base}/`}><span class="dot"></span> {t("brand")}</a>
    <p class="copy">© {year} {t("brand")} · {t("footer.rights")}</p>
    <nav class="foot-links">
      <a href={`${base}/rss.xml`}>RSS</a>
      <a href={`${base}/privacy/`}>{t("footer.privacy")}</a>
      <a href={`${base}/terms/`}>{t("footer.terms")}</a>
      <a href={`mailto:${SITE_EMAIL}`}>{t("footer.contact")}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding: 48px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
  .foot-links {
    display: flex;
    gap: 20px;
  }
  .foot-links a:hover {
    color: var(--text);
  }
  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
