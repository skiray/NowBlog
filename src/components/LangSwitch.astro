---
import { languages, defaultLocale, type Locale } from "../i18n/ui";

interface Props {
  /**
   * Explicit per-locale URLs, used by article pages so a translation that does
   * not exist (draft / untranslated) falls back to that locale's blog index
   * instead of a 404.
   */
  hrefs?: Partial<Record<Locale, string>>;
}

const { hrefs } = Astro.props;
const current = (Astro.currentLocale ?? defaultLocale) as Locale;
const path = Astro.url.pathname;

function switchTo(target: Locale): string {
  const hasEn = path.startsWith("/en");
  if (target === "en") return hasEn ? path : "/en" + path;
  return hasEn ? path.slice(3) || "/" : path;
}

function hrefFor(target: Locale): string {
  return hrefs?.[target] ?? switchTo(target);
}
---

<div class="lang">
  {
    Object.entries(languages).map(([l, label]) => {
      const target = l as Locale;
      return (
        <a
          href={hrefFor(target)}
          hreflang={target}
          class={target === current ? "active" : ""}
          aria-current={target === current ? "true" : undefined}
        >
          {label}
        </a>
      );
    })
  }
</div>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: 4px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px;
    background: var(--ghost-bg);
  }
  .lang a {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    color: var(--text-dim);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .lang a:hover {
    color: var(--text);
  }
  .lang a.active {
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
</style>
