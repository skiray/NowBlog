---
import { useTranslations } from "../i18n/ui";
import { getPosts, slugOf } from "../i18n/content";

const locale = (Astro.currentLocale ?? "zh") as "zh" | "en";
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 5);
const base = locale === "en" ? "/en/blog/" : "/blog/";

const fmt = (d: Date) =>
  d.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<section class="section" id="latest">
  <div class="container">
    <div class="head reveal">
      <span class="eyebrow">{t("latest.eyebrow")}</span>
      <h2>{t("latest.title")}</h2>
      <p class="sub">{t("latest.sub")}</p>
    </div>
    <div class="list">
      {
        posts.map((post, i) => (
          <a class="card reveal" style={`--i:${i}`} href={`${base}${slugOf(post)}/`}>
            <div class="body">
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <div class="tags">
              {post.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
    <div class="more reveal">
      <a class="btn btn-ghost" href={base}>{t("latest.all")}</a>
    </div>
  </div>
</section>

<style>
  .head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 56px;
  }
  h2 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    margin: 12px 0 12px;
  }
  .sub {
    color: var(--text-dim);
  }
  .list {
    display: grid;
    gap: 18px;
  }
  .card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 30px 34px;
    transition: transform 0.2s ease, border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(109, 139, 255, 0.5);
    box-shadow: 0 24px 50px -24px rgba(109, 139, 255, 0.45);
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  .meta {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin-bottom: 10px;
  }
  .card h3 {
    font-size: 1.45rem;
    margin-bottom: 10px;
    line-height: 1.25;
  }
  .card p {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 16px;
    max-width: 60ch;
  }
  .tags {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
    flex-shrink: 0;
  }
  .tag {
    font-size: 0.72rem;
    color: var(--accent);
    background: rgba(109, 139, 255, 0.12);
    padding: 4px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .more {
    text-align: center;
    margin-top: 40px;
  }
  @media (max-width: 640px) {
    .card {
      flex-direction: column;
      gap: 16px;
      padding: 24px;
    }
    .tags {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
    }
  }
</style>
