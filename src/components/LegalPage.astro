---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { defaultLocale, useTranslations, type Locale } from "../i18n/ui";
import { LEGAL_UPDATED } from "../consts";

interface Props {
  title: string;
  sub: string;
  body: string;
}

const { title, sub, body } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const base = locale === defaultLocale ? "" : `/${locale}`;
---

<Layout title={title} description={sub}>
  <Navbar />
  <main class="section">
    <div class="container narrow">
      <h1 class="reveal">{title}</h1>
      <p class="sub reveal">{sub}</p>
      <p class="updated">{t("legal.updated")} · {LEGAL_UPDATED}</p>
      <div class="prose reveal" set:html={body} />
      <p class="back"><a href={`${base}/`}>{t("legal.back")}</a></p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 720px;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 12px;
  }
  .sub {
    color: var(--text-dim);
    font-size: 1.05rem;
    margin-bottom: 10px;
  }
  .updated {
    color: var(--text-dim);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 32px;
  }
  .prose {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.85;
  }
  .prose :global(p) {
    margin-bottom: 18px;
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    color: var(--text);
    margin: 34px 0 12px;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 22px;
    margin-bottom: 18px;
    display: grid;
    gap: 10px;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.88em;
  }
  .back {
    margin-top: 40px;
    font-size: 0.9rem;
  }
  .back a {
    color: var(--text-dim);
    transition: color 0.2s ease;
  }
  .back a:hover {
    color: var(--accent);
  }
</style>
