---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Giscus from "../components/Giscus.astro";
import PostCard from "../components/PostCard.astro";
import AuthorCard from "../components/AuthorCard.astro";
import LatestList from "../components/LatestList.astro";
import { render } from "astro:content";
import { useTranslations } from "../i18n/ui";
import {
  type Post,
  tagHref,
  authorHref,
  blogHref,
  slugOf,
  getPosts,
  getAdjacent,
  getRelated,
  getSeries,
  readingMinutes,
} from "../i18n/content";

interface Props {
  post: Post;
  locale: "zh" | "en";
}
const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { Content, headings } = await render(post);
// `footnote-label` is the heading remark-gfm injects above the footnotes
// list. It is visually hidden, so it must not become a TOC entry either.
const toc = headings.filter(
  (h) => h.depth >= 2 && h.depth <= 3 && h.slug !== "footnote-label"
);
const { newer, older } = await getAdjacent(locale, post);
const related = await getRelated(locale, post);
const series = await getSeries(locale, post);

// Language switch targets: link to the translation when it exists (it may still
// be a draft or untranslated), otherwise fall back to that locale's blog index.
const otherLocale = locale === "zh" ? ("en" as const) : ("zh" as const);
const counterpart = (await getPosts(otherLocale)).find(
  (p) => slugOf(p) === slugOf(post)
);
const selfHref = `${blogHref(locale)}${slugOf(post)}/`;
const otherHref = counterpart
  ? `${blogHref(otherLocale)}${slugOf(counterpart)}/`
  : blogHref(otherLocale);
const langHrefs: Partial<Record<"zh" | "en", string>> = {
  zh: locale === "zh" ? selfHref : otherHref,
  en: locale === "en" ? selfHref : otherHref,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { "@type": "Person", name: post.data.author },
  keywords: post.data.tags.join(", "),
  inLanguage: locale === "en" ? "en" : "zh-CN",
  mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
  ...(post.data.cover
    ? {
        image: new URL(
          post.data.cover,
          Astro.site ?? "https://nowblog.pages.dev"
        ).href,
      }
    : null),
};
const fmt = post.data.pubDate.toLocaleDateString(
  locale === "en" ? "en-US" : "zh-CN",
  { year: "numeric", month: "long", day: "numeric" }
);
---

    <Layout
  title={`${post.data.title} — ${locale === "en" ? "NowBlog" : "今时录"}`}
  description={post.data.description}
  indexable
>
     <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
     <Navbar langHrefs={langHrefs} />
   <div class="progress" aria-hidden="true"></div>
   <button id="to-top" class="to-top" type="button" aria-label="Back to top">
     ↑
   </button>
   <main class="section">
     <div class="container post-layout">
       <aside class="rail left">
         <div class="info">
           <h2 class="info-title">{t("post.info")}</h2>
           <div class="info-row">
             <span>{t("post.published")}</span>
             <time datetime={post.data.pubDate.toISOString()}>{fmt}</time>
           </div>
            <div class="info-row">
              <span>{t("post.author")}</span>
              <a href={authorHref(locale, post.data.author)} data-pagefind-meta="author">{post.data.author}</a>
            </div>
           <div class="info-row">
             <span>{t("post.reading")}</span>
             <span>{readingMinutes(post)} {t("post.read")}</span>
           </div>
         </div>
         {
           toc.length > 0 && (
             <nav class="toc" aria-label={t("post.toc")}>
               <p class="toc-title">{t("post.toc")}</p>
               <ul>
                 {toc.map((h) => (
                   <li class={`lvl-${h.depth}`}>
                     <a href={`#${h.slug}`}>{h.text}</a>
                   </li>
                 ))}
               </ul>
             </nav>
           )
         }
       </aside>

       <article class="post-main">
         {
           post.data.cover && (
             <img class="cover" src={post.data.cover} alt={post.data.title} />
           )
         }
         <div class="reveal">
           <a class="back" href={blogHref(locale)}>{t("blog.back")}</a>
           <h1 data-pagefind-meta="title">{post.data.title}</h1>
           <p class="lead" data-pagefind-meta="description">{post.data.description}</p>
           <div class="tags">
             {
               post.data.tags.map((tag) => (
                 <a class="tag" href={tagHref(locale, tag)} data-pagefind-filter="tag">
                   {tag}
                 </a>
               ))
             }
           </div>
          </div>

          {
            series.length > 0 && (
              <nav class="series" aria-label={t("post.series")}>
                <p class="series-title">{t("post.series")}：{post.data.series}</p>
                <ol>
                  {series.map((p) => (
                    <li class={p.id === post.id ? "current" : ""}>
                      <a href={`${blogHref(locale)}${slugOf(p)}/`}>{p.data.title}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          <hr />
          <span hidden data-pagefind-filter={`lang:${locale}`}></span>
          <div class="prose" data-pagefind-body data-pagefind-highlight>
           <Content />
         </div>

         <nav class="pager">
           {
             older && (
               <a class="pager-link" href={`${blogHref(locale)}${slugOf(older)}/`}>
                 <span>{t("post.prev")}</span>
                 <strong>{older.data.title}</strong>
               </a>
             )
           }
           {
             newer && (
               <a
                 class="pager-link next"
                 href={`${blogHref(locale)}${slugOf(newer)}/`}
               >
                 <span>{t("post.next")}</span>
                 <strong>{newer.data.title}</strong>
               </a>
             )
           }
         </nav>

         <Giscus />

         {
           related.length > 0 && (
             <section class="related">
               <h2>{t("post.related")}</h2>
               <div class="list">
                 {related.map((p, i) => (
                   <PostCard post={p} locale={locale} base={blogHref(locale)} index={i} />
                 ))}
               </div>
             </section>
           )
         }
       </article>

       <aside class="rail right">
         <AuthorCard />
         <div class="widget">
           <h3 class="widget-title">{t("sidebar.tags")}</h3>
           <div class="tags">
             {
               post.data.tags.map((tag) => (
                 <a class="tag" href={tagHref(locale, tag)} data-pagefind-filter="tag">
                   {tag}
                 </a>
               ))
             }
           </div>
         </div>
         <div class="widget">
           <h3 class="widget-title">{t("sidebar.latest")}</h3>
           <LatestList locale={locale} count={5} exclude={post.id} />
         </div>
       </aside>
     </div>
   </main>
   <Footer />
</Layout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 720px) 240px;
    gap: 40px;
    justify-content: center;
    align-items: start;
    max-width: 1240px;
  }
  .post-main {
    min-width: 0;
  }
  .rail {
    position: sticky;
    top: 84px;
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .info {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .info-title {
    font-size: 0.95rem;
    margin-bottom: 14px;
  }
  .info-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.85rem;
    padding: 6px 0;
    border-top: 1px solid var(--border);
  }
  .info-row:first-of-type {
    border-top: none;
  }
  .info-row span:first-child {
    color: var(--text-dim);
  }
  .widget {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .widget-title {
    font-size: 1rem;
    margin-bottom: 14px;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 28px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin-bottom: 12px;
  }
  .lead {
    color: var(--text-dim);
    font-size: 1.15rem;
    margin-bottom: 16px;
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    color: var(--accent);
    background: rgba(109, 139, 255, 0.12);
    padding: 3px 10px;
    border-radius: 999px;
  }
  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 28px 0;
  }
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(0);
    animation: progress-grow linear both;
    animation-timeline: scroll(root block);
  }
  @keyframes progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .toc {
    margin: 0;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .toc-title {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 10px;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .toc .lvl-3 {
    padding-left: 16px;
  }
  .toc a {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .toc a:hover,
  .toc a.active {
    color: var(--accent);
  }
  .prose {
    /* Long URLs / unbroken strings must not punch out of the column. */
    overflow-wrap: break-word;
  }
  .prose :global(h1) {
    font-size: 1.75rem;
    margin: 36px 0 14px;
    scroll-margin-top: 84px;
    position: relative;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 32px 0 12px;
    scroll-margin-top: 84px;
    position: relative;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin: 24px 0 10px;
    scroll-margin-top: 84px;
    position: relative;
  }
  .prose :global(h4) {
    font-size: 1.05rem;
    margin: 20px 0 8px;
    scroll-margin-top: 84px;
    position: relative;
  }
  .prose :global(.anchor) {
    position: absolute;
    left: -1.1em;
    opacity: 0;
    color: var(--accent);
    font-weight: 400;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  /* `.anchor` is created at runtime, so it carries no scope attribute — the
     whole selector has to be global or the hover rule never matches. */
  .prose :global(:is(h1, h2, h3, h4):hover .anchor) {
    opacity: 1;
  }
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.15s ease;
    z-index: 55;
    box-shadow: var(--shadow);
  }
  .to-top.show {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .to-top:hover {
    border-color: var(--accent);
  }
  @media (max-width: 720px) {
    .prose :global(.anchor) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: none;
    }
  }
  .prose :global(p) {
    color: var(--text-dim);
    margin-bottom: 16px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .prose :global(ul),
  .prose :global(ol) {
    color: var(--text-dim);
    padding-left: 22px;
    margin-bottom: 16px;
    display: grid;
    gap: 8px;
  }
  .prose :global(code) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.88em;
  }
  /* Code blocks come from Expressive Code (astro-expressive-code). It ships
     its own frame, border, radius and copy button, so only the vertical
     rhythm is left to us — restyling the `pre` here would fight its reset. */
  .prose :global(.expressive-code) {
    margin-bottom: 16px;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 16px;
    color: var(--text-dim);
    margin-bottom: 16px;
  }
  /* GFM task lists: the bullet is redundant next to the checkbox. */
  .prose :global(ul.contains-task-list) {
    padding-left: 4px;
  }
  .prose :global(li.task-list-item) {
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .prose :global(li.task-list-item input) {
    margin: 0;
    accent-color: var(--accent);
  }
  /* GFM footnotes. remark-gfm emits an <h2 class="sr-only"> here; the class is
     not defined by this theme, so hide the heading properly. */
  .prose :global(.footnotes) {
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .prose :global(.footnotes .sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .prose :global(.data-footnote-backref) {
    text-decoration: none;
  }
  /* `---` inside the article body. Rendered by <Content />, so it carries no
     scope class and the component-level `hr` rule above does not apply. */
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }
  /* Markdown tables. remark emits no wrapper element, so the table itself has
     to be the scroll container for wide comparison tables. */
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 0.93rem;
    line-height: 1.65;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(thead th) {
    background: var(--surface-2);
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(tbody td) {
    color: var(--text-dim);
  }
  .prose :global(tbody tr:nth-child(even)) {
    background: var(--ghost-bg);
  }
  .prose :global(img) {
    cursor: zoom-in;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 16px;
  }
  /* Diagrams: wide ones scroll instead of overflowing the column. The mono
     font is only visible before (or if) Mermaid renders. */
  .prose :global(.mermaid) {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 16px;
    margin-bottom: 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre;
  }
  .prose :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
  /* Same story as .copy-btn: the overlay is built in the client script, so
     these rules must be global. */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.82);
    opacity: 0;
    pointer-events: none;
    cursor: zoom-out;
    transition: opacity 0.2s ease;
  }
  :global(.lightbox.show) {
    opacity: 1;
    pointer-events: auto;
  }
  :global(.lightbox img) {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.lightbox) {
      transition: none;
    }
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 36px;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pager-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .pager-link.next {
    text-align: right;
  }
  .pager-link span {
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .pager-link strong {
    font-size: 0.98rem;
    font-weight: 600;
  }
  .related {
    margin-top: 48px;
  }
  .related h2 {
    font-size: 1.3rem;
    margin-bottom: 18px;
  }
  .related .list {
    display: grid;
    gap: 20px;
  }
  .series {
    margin-top: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 22px;
  }
  .series-title {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  .series ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
    counter-reset: s;
  }
  .series li {
    counter-increment: s;
  }
  .series li a {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .series li a::before {
    content: counter(s) ". ";
    color: var(--accent);
  }
  .series li.current a {
    color: var(--accent);
    font-weight: 600;
  }
  .series li a:hover {
    color: var(--text);
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      text-align: left;
    }
  }
  @media (max-width: 1120px) {
    .post-layout {
      grid-template-columns: minmax(0, 760px);
      max-width: 760px;
      margin: 0 auto;
    }
    .rail {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .rail.left {
      display: none;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc a"));
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  // Only h2/h3 are listed in the TOC, so only they drive the scroll-spy: an
  // observed h4 would clear the highlight without ever setting a new one.
  const spy = document.querySelectorAll<HTMLElement>(".prose :is(h2, h3)");
  if (spy.length && links.length) {
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove("active"));
            byId.get(e.target.id)?.classList.add("active");
          }
        }
      },
      { rootMargin: "0px 0px -70% 0px" }
    );
    spy.forEach((h) => h.id && obs.observe(h));
  }

  document.querySelectorAll<HTMLElement>(".prose :is(h1, h2, h3, h4)").forEach((h) => {
    if (!h.id) return;
    const a = document.createElement("a");
    a.className = "anchor";
    a.href = `#${h.id}`;
    a.setAttribute("aria-label", "Link to section");
    a.textContent = "#";
    a.addEventListener("click", async (e) => {
      e.preventDefault();
      const url = `${location.pathname}#${h.id}`;
      history.replaceState(null, "", url);
      await navigator.clipboard.writeText(location.origin + url);
      a.textContent = "✓";
      setTimeout(() => (a.textContent = "#"), 1200);
    });
    h.appendChild(a);
  });

  const toTop = document.getElementById("to-top");
  if (toTop) {
    const onScroll = () =>
      toTop.classList.toggle("show", window.scrollY > 600);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    toTop.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" })
    );
  }

  // No copy button here: Expressive Code renders one itself (with an
  // aria-live announcement) at build time.

  const overlay = document.createElement("div");
  overlay.className = "lightbox";
  const lbImg = document.createElement("img");
  lbImg.alt = "";
  overlay.appendChild(lbImg);
  document.body.appendChild(overlay);
  overlay.addEventListener("click", () => overlay.classList.remove("show"));
  document
    .querySelectorAll<HTMLImageElement>(".prose img")
    .forEach((img) => {
      img.addEventListener("click", () => {
        lbImg.src = img.currentSrc || img.src;
        overlay.classList.add("show");
      });
    });

  // Diagrams. `mermaid` is behind a dynamic import, so posts without a
  // ```mermaid block never download it.
  const diagrams = Array.from(
    document.querySelectorAll<HTMLElement>(".prose .mermaid")
  );
  if (diagrams.length) {
    diagrams.forEach((el, i) => {
      if (!el.id) el.id = `mermaid-${i}`;
    });
    const sources = new Map(
      diagrams.map((el) => [el.id, el.textContent ?? ""])
    );

    const paint = async () => {
      const { default: mermaid } = await import("mermaid");
      const dark = document.documentElement.dataset.theme !== "light";
      mermaid.initialize({
        startOnLoad: false,
        theme: dark ? "dark" : "default",
        securityLevel: "strict",
      });
      // mermaid.run() skips nodes already marked as processed, so restore the
      // original source before repainting on a theme switch.
      diagrams.forEach((el) => {
        el.textContent = sources.get(el.id) ?? "";
        el.removeAttribute("data-processed");
      });
      await mermaid.run({ nodes: diagrams });
    };

    paint();
    document.addEventListener("theme-change", () => paint());
  }
</script>
