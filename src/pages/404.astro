---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const home = "/";
const blog = "/blog/";
---

<Layout title="404 — 页面未找到">
  <Navbar />
  <main class="section">
    <div class="container narrow center">
      <span class="eyebrow">404</span>
      <h1 class="reveal">页面走丢了</h1>
      <p class="sub reveal">你访问的页面不存在，或已经被移动。</p>
      <div class="actions reveal">
        <a class="btn btn-primary" href={home}>返回首页</a>
        <a class="btn btn-ghost" href={blog}>查看博客</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 640px;
  }
  .center {
    text-align: center;
    padding: 80px 0;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin: 12px 0;
  }
  .sub {
    color: var(--text-dim);
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
