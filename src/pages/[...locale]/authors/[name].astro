---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { useTranslations, type Locale } from "../../../i18n/ui";
import {
  getAuthors,
  getPostsByAuthor,
  slugOf,
  type Post,
} from "../../../i18n/content";
import { localeFrom, localePaths, prefix } from "../../../i18n/routing";

interface Props {
  locale: Locale;
  author: string;
  posts: Post[];
}

export async function getStaticPaths() {
  const paths: { params: Record<string, string | undefined>; props: Props }[] =
    [];

  for (const { params } of localePaths()) {
    const locale = localeFrom(params);
    for (const author of await getAuthors(locale)) {
      paths.push({
        params: { ...params, name: author },
        props: { locale, author, posts: await getPostsByAuthor(locale, author) },
      });
    }
  }

  return paths;
}

const { locale, author, posts } = Astro.props;
const t = useTranslations(locale);

const p = prefix(locale);
const base = `${p}/blog/`;
const fmt = (d: Date) =>
  d.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout
  title={`${author} — ${t("brand")}`}
  description={t("authors.desc").replace("{name}", author)}
>
  <Navbar />
  <main class="section">
    <div class="container narrow">
      <a class="back reveal" href={`${p}/authors/`}>{t("authors.back")}</a>
      <h1 class="reveal">{author}</h1>
      <p class="count reveal">{posts.length} {t("authors.count")}</p>
      <a
        class="rss reveal"
        href={`${p}/authors/${encodeURIComponent(author)}/rss.xml`}>RSS</a
      >
      <div class="list">
        {
          posts.map((post, i) => (
            <a
              class="post reveal"
              style={`--i:${i}`}
              href={`${base}${slugOf(post)}/`}
            >
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 8px;
    background: linear-gradient(120deg, var(--accent-3), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .count {
    color: var(--text-dim);
    margin-bottom: 32px;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .post {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .meta {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin-bottom: 8px;
  }
  .post h2 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .post p {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .rss {
    display: inline-block;
    margin-bottom: 24px;
    font-size: 0.8rem;
    color: var(--accent);
    border: 1px solid var(--border);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .rss:hover {
    border-color: var(--accent);
  }
</style>
