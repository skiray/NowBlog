---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import PostCard from "../../../components/PostCard.astro";
import { useTranslations } from "../../../i18n/ui";
import { getArchive } from "../../../i18n/content";
import { localeFrom, localePaths, prefix } from "../../../i18n/routing";

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.params);
const t = useTranslations(locale);
const groups = await getArchive(locale);
const base = `${prefix(locale)}/blog/`;
---

<Layout title={t("blog.archive")} description={t("blog.sub")}>
  <Navbar />
  <main>
    <section class="section">
      <div class="container narrow">
        <span class="eyebrow">{t("blog.archive")}</span>
        <h1 class="reveal">{t("blog.archive")}</h1>
        <p class="sub reveal">{t("blog.sub")}</p>

        {groups.length === 0 && <p class="empty">{t("blog.empty")}</p>}
        {
          groups.map((g) => (
            <div class="year-group">
              <h2 class="year reveal">{g.year}</h2>
              <div class="list">
                {g.posts.map((post, i) => (
                  <PostCard post={post} locale={locale} base={base} index={i} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
    <Footer />
  </main>
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 12px 0 8px;
  }
  .sub {
    color: var(--text-dim);
    margin-bottom: 40px;
  }
  .year-group {
    margin-bottom: 48px;
  }
  .year {
    font-size: 1.4rem;
    margin-bottom: 18px;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .list {
    display: grid;
    gap: 20px;
  }
  .empty {
    color: var(--text-dim);
  }
</style>
