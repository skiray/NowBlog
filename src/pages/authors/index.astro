---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { useTranslations } from "../../i18n/ui";
import { getAuthors, getPostsByAuthor, authorHref, type Post } from "../../i18n/content";

const locale = "zh" as const;
const t = useTranslations(locale);
const authors = await getAuthors("zh");
const counts = await Promise.all(
  authors.map(async (a) => ({ a, n: (await getPostsByAuthor("zh", a)).length }))
);
---

<Layout title={`${t("authors.title")} — 今时录`} description="站点作者列表。">
  <Navbar />
  <main class="section">
    <div class="container narrow">
      <h1 class="reveal">{t("authors.title")}</h1>
      <div class="list">
        {
          counts.map(({ a, n }, i) => (
            <a class="post reveal" style={`--i:${i}`} href={authorHref("zh", a)}>
              <h2>{a}</h2>
              <p>{n} {t("authors.count")}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 32px;
    background: linear-gradient(120deg, var(--accent-3), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .post {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .post h2 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .post p {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
</style>
