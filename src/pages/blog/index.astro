---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { useTranslations } from "../../i18n/ui";
import { getPosts, PAGE_SIZE } from "../../i18n/content";

const locale = "zh" as const;
const t = useTranslations(locale);
const all = await getPosts(locale);
const posts = all.slice(0, PAGE_SIZE);
const lastPage = Math.ceil(all.length / PAGE_SIZE);
const base = "/blog/";
const pageBase = "/blog/page";
---

<Layout title={t("blog.title")} description={t("blog.sub")}>
  <Navbar />
  <main>
    <section class="section">
      <div class="container narrow">
        <span class="eyebrow">{t("blog.title")}</span>
        <h1 class="reveal">{t("blog.title")}</h1>
        <p class="sub reveal">{t("blog.sub")}</p>

        <div class="list">
          {
            posts.map((post, i) => (
              <PostCard post={post} locale={locale} base={base} index={i} />
            ))
          }
          {posts.length === 0 && <p class="empty">{t("blog.empty")}</p>}
        </div>

        <Pagination
          currentPage={1}
          lastPage={lastPage}
          rootHref="/blog"
          pageBase="/blog/page"
        />
      </div>
    </section>
    <Footer />
  </main>
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 12px 0 8px;
  }
  .sub {
    color: var(--text-dim);
    margin-bottom: 40px;
  }
  .list {
    display: grid;
    gap: 20px;
  }
  .empty {
    color: var(--text-dim);
  }
</style>
