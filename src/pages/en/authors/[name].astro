---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { useTranslations } from "../../../i18n/ui";
import { getPosts, getPostsByAuthor, slugOf, type Post } from "../../../i18n/content";

const locale = "en" as const;
const t = useTranslations(locale);

export async function getStaticPaths() {
  const posts = await getPosts("en");
  const authors = [...new Set(posts.map((p) => p.data.author))];
  return Promise.all(
    authors.map(async (author) => ({
      params: { name: author },
      props: { author, posts: await getPostsByAuthor("en", author) },
    }))
  );
}

interface Props {
  author: string;
  posts: Post[];
}
const { author, posts } = Astro.props;
const base = "/en/blog/";
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title={`${author} — NowBlog`} description={`Posts by ${author}.`}>
  <Navbar />
  <main class="section">
    <div class="container narrow">
      <a class="back reveal" href="/en/authors/">{t("authors.back")}</a>
      <h1 class="reveal">{author}</h1>
      <p class="count reveal">{posts.length} {t("authors.count")}</p>
      <div class="list">
        {
          posts.map((post, i) => (
            <a class="post reveal" style={`--i:${i}`} href={`${base}${slugOf(post)}/`}>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 8px;
    background: linear-gradient(120deg, var(--accent-3), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .count {
    color: var(--text-dim);
    margin-bottom: 32px;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .post {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .meta {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin-bottom: 8px;
  }
  .post h2 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .post p {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
</style>
