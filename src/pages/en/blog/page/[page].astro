---
import Layout from "../../../../layouts/Layout.astro";
import Navbar from "../../../../components/Navbar.astro";
import Footer from "../../../../components/Footer.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { useTranslations } from "../../../../i18n/ui";
import { getPosts, type Post, PAGE_SIZE } from "../../../../i18n/content";

const locale = "en" as const;
const t = useTranslations(locale);
const base = "/en/blog/";
const pageBase = "/en/blog/page";

export async function getStaticPaths() {
  const pageSize = PAGE_SIZE;
  const all = await getPosts("en");
  const lastPage = Math.max(1, Math.ceil(all.length / pageSize));
  return Array.from({ length: lastPage }, (_, i) => {
    const p = i + 1;
    return {
      params: { page: String(p) },
      props: {
        posts: all.slice((p - 1) * pageSize, p * pageSize),
        currentPage: p,
        lastPage,
      },
    };
  });
}

interface Props {
  posts: Post[];
  currentPage: number;
  lastPage: number;
}
const { posts, currentPage, lastPage } = Astro.props;
---

<Layout
  title={`${t("blog.title")} · ${currentPage}`}
  description={t("blog.sub")}
>
  <Navbar />
  <main>
    <section class="section">
      <div class="container narrow">
        <span class="eyebrow">{t("blog.title")}</span>
        <h1 class="reveal">{t("blog.title")}</h1>
        <p class="sub reveal">{t("blog.sub")}</p>

        <div class="list">
          {
            posts.map((post, i) => (
              <PostCard post={post} locale={locale} base={base} index={i} />
            ))
          }
        </div>

        <Pagination
          currentPage={currentPage}
          lastPage={lastPage}
          rootHref="/en/blog"
          pageBase="/en/blog/page"
        />
      </div>
    </section>
    <Footer />
  </main>
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 12px 0 8px;
  }
  .sub {
    color: var(--text-dim);
    margin-bottom: 40px;
  }
  .list {
    display: grid;
    gap: 20px;
  }
</style>
