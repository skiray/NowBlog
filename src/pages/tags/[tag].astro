---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { useTranslations } from "../../i18n/ui";
import { getPosts, slugOf, type Post } from "../../i18n/content";

const locale = "zh" as const;
const t = useTranslations(locale);

export async function getStaticPaths() {
  const posts = await getPosts("zh");
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
const base = "/blog/";
const fmt = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout title={`#${tag} — 今时录`} description={`标签 ${tag} 下的文章。`}>
  <Navbar />
  <main class="section">
    <div class="container narrow">
      <a class="back reveal" href="/tags/">{t("tags.back")}</a>
      <h1 class="reveal">#{tag}</h1>
      <div class="list">
        {
          posts.map((post, i) => (
            <a class="post reveal" style={`--i:${i}`} href={`${base}${slugOf(post)}/`}>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 36px;
    background: linear-gradient(120deg, var(--accent-3), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .post {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .meta {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin-bottom: 8px;
  }
  .post h2 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .post p {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
</style>
